# WMATA developer API (free, register at https://developer.wmata.com)
# One key works across the Rail Predictions, Rail Incidents, and Bus Predictions APIs.
WMATA_API_KEY=your_wmata_api_key_here

# Google Maps Platform — Directions API (bicycling mode) for routed bike-leg
# distance/time. Enable "Directions API" and billing at
# https://console.cloud.google.com. Server-side only, never exposed to the browser.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Anthropic API key for the reasoning layer (route/station recommendation + caveats).
# https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here
