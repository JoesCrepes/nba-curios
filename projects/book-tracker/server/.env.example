# Hardcover GraphQL API token (Account Settings -> API on hardcover.app)
# Paste exactly what Hardcover gives you; a "Bearer " prefix is added automatically if missing.
HARDCOVER_API_TOKEN=

# Where the SQLite database file lives. Defaults to ./data/book-tracker.db
DB_PATH=./data/book-tracker.db

# Port for the local API server
PORT=4310

# 32-byte hex key used to encrypt the Libby identity token at rest (AES-256-GCM).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LIBBY_TOKEN_ENC_KEY=
